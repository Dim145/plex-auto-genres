# ---------------------------------------------------------------------------
# Plex connection
#
# Token auth is preferred: it does not put your account password on disk and
# it skips the plex.tv round trip on every run.
# Finding your token: https://support.plex.tv/articles/204059436
# ---------------------------------------------------------------------------
PLEX_BASE_URL="http://192.168.1.10:32400"
PLEX_TOKEN=""

# Legacy alternative. Only used when PLEX_TOKEN/PLEX_BASE_URL are unset.
PLEX_USERNAME=""
PLEX_PASSWORD=""
PLEX_SERVER_NAME=""

# Prepended to every genre/collection name this tool writes. Handy for telling
# them apart from tags Plex's own agents added.
PLEX_COLLECTION_PREFIX=""

# Seconds before a Plex request is abandoned.
PLEX_TIMEOUT="30"

# ---------------------------------------------------------------------------
# Metadata providers
# ---------------------------------------------------------------------------
# Required by a library reading from tmdb: standard-tv and standard-movie
# libraries do by default. Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
TMDB_LANGUAGE="en-US"

# Only for libraries reading from "ams": your arr-metadata-server, whose
# catalogue -- corrections locked there included -- is read through the
# metadata provider it serves Plex. Its address as this app reaches it, not
# through a reverse proxy, e.g. http://arr-metadata-server:8080; the one it
# gives Plex, ending in /plex, works too. Allow the address it sees this app
# call from under Keys & network > Allowed addresses, beside Plex's; the key
# is only for a server that asks for one instead (AMS_PLEX_AUTH=apikey).
ARR_METADATA_URL=""
ARR_METADATA_API_KEY=""

# How much of AniList's community must agree with a tag before it is written,
# as a percentage. AniList's own page lists tags far below this; lower it to
# take more of them, at the cost of noise. Only matters with useKeywords.
ANILIST_TAG_RANK="70"

# ---------------------------------------------------------------------------
# Web UI (plex-auto-genres serve)
# ---------------------------------------------------------------------------
# Login password. Required to listen beyond loopback; scripts send it as a
# bearer token. Leave empty for a local, loopback-only console.
PAG_WEB_PASSWORD=""
# Behind a reverse proxy: its address(es), so X-Forwarded-For is believed for
# the login rate limit, and set PAG_WEB_SECURE_COOKIE=1 when it terminates TLS.
PAG_WEB_TRUSTED_PROXIES=""

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Concurrent provider lookups. The per-provider rate limits are enforced
# independently, so raising this mostly helps when the network is the
# bottleneck rather than the API quota.
PAG_CONCURRENCY="4"

# Attempts per item before it is recorded as failed (and retried later with
# an exponential backoff).
PAG_MAX_ATTEMPTS="3"
